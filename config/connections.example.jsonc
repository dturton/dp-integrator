// Example connections file. One entry per Shopify store → NS account.
// In production, connections are stored in `dbo.connections` and hydrated at
// runtime; this JSONC is for local dev + CI fixtures.
//
// Field semantics: see `packages/core/src/types.ts:Connection`.
[
  {
    "connectionId": "acme-us",
    "environment": "dev",
    "shopifyStore": "acme-us.myshopify.com",
    // Secret-provider refs — names of secrets in Key Vault (prod) or env vars (local).
    // NEVER the raw values here. You can authenticate Shopify in either mode:
    //   1. direct Admin token
    //      - shopifyAppTokenRef       → Admin API access token
    //   2. client-credential exchange
    //      - shopifyClientIdRef       → app client id
    //      - shopifyClientSecretRef   → app client secret
    //
    // Webhook verification is always separate:
    //   - shopifyWebhookSecretRef  → shared secret used for HMAC on inbound webhooks
    "shopifyAppTokenRef": "shopify-token-acme-us",
    // "shopifyClientIdRef": "shopify-client-id-acme-us",
    // "shopifyClientSecretRef": "shopify-client-secret-acme-us",
    "shopifyWebhookSecretRef": "shopify-webhook-secret-acme-us",
    "nsAccountId": "1234567",
    "nsSubsidiary": "1",
    "nsLocation": "10",
    "baseCurrency": "USD",
    "taxEngine": "suitetax",
    "orderTarget": "sales_order",
    "mapVersion": "v1",
    "enabled": true
  },
  {
    "connectionId": "beta-eu",
    "environment": "dev",
    "shopifyStore": "beta-eu.myshopify.com",
    "shopifyAppTokenRef": "shopify-token-beta-eu",
    // "shopifyClientIdRef": "shopify-client-id-beta-eu",
    // "shopifyClientSecretRef": "shopify-client-secret-beta-eu",
    "shopifyWebhookSecretRef": "shopify-webhook-secret-beta-eu",
    "nsAccountId": "7654321",
    "nsSubsidiary": "3",
    "baseCurrency": "EUR",
    "taxEngine": "legacy",
    "orderTarget": "cash_sale",
    "mapVersion": "v1",
    "enabled": true
  }
]
